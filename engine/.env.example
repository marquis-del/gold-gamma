# Copy to .env and fill in. NEVER commit .env.  (.env is git-ignored.)

# --- dxFeed (primary data source) ---
# Get these from your dxFeed account / Devexperts. Endpoint + auth token.
DXFEED_WS_URL=wss://demo.dxfeed.com/dxlink-ws     # replace with your PRODUCTION endpoint
DXFEED_TOKEN=                                      # your dxFeed auth token (bearer/QD token)

# --- Publishing the dashboard + levels.json (optional, phase 1 can write locally) ---
# If you deploy to a static host, put any deploy creds here (e.g. a Cloudflare/Netlify token).
PUBLISH_TARGET=local        # local | (later) netlify | cloudflare | s3 | githubpages

# --- FRED (optional — real 10Y yield + breakeven inflation for the macro panel) ---
# Free instant signup: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, the macro regime read falls back to the nominal ^TNX yield.
FRED_API_KEY=
